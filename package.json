{
  "name": "trojans-proxy-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen-endpoints": "node scripts/generate-endpoints.js",
    "gen-fresh": "cross-env FORCE_REGEN=1 node scripts/generate-endpoints.js",
    "vendor:firefox-wasm": "node scripts/vendor-firefox-wasm.js",
    "dev": "npm run gen-endpoints && vite",
    "build": "npm run gen-endpoints && npm run vendor:firefox-wasm && tsc && vite build",
    "preview": "vite preview",
    "server": "node server/server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}